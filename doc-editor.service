[Unit]
Description=doc-editor MCP server (Word/DOCX editor, word-mcp-live fork)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f doc-editor
ExecStart=/bin/bash -c 'exec /usr/bin/docker run --name doc-editor --restart unless-stopped --network lobechat_default -p 127.0.0.1:9113:9113 -v /home/v1smut/doc-editor:/app -w /app -e MCP_TRANSPORT=streamable-http -e MCP_HOST=0.0.0.0 -e MCP_PORT=9113 -e MCP_PATH=/sse -e MCP_AUTHOR=V1sMUT -e MCP_AUTHOR_INITIALS=VS -e TOOL_WHITELIST="docx_read,docx_formula,docx_highlight,search_and_replace,delete_paragraph,insert_line_or_paragraph_near_text,find_text_in_document,docx_open,docx_commit,add_paragraph,docx_number_formulas,get_highlighted_text,docx_build,get_paragraph_text_from_document,file_read,docx_undo,replace_block_between_manual_anchors,track_replace,merge_table_cells_vertical,list_available_documents,format_text,accept_tracked_changes,docx_create,add_table,replace_paragraph_block_below_header,add_heading,copy_document,format_table,insert_header_near_text,highlight_table_header,list_tracked_changes,docx_caption,docx_crossref,docx_docproperty,docx_replace_font,docx_replace_table,docx_fill,docx_append_block,track_insert,track_delete,add_header_footer,add_page_numbers,add_table_of_contents,add_bookmark" -e PGHOST=lobe-postgres -e PGDATABASE=lobechat -e PGUSER=postgres -e PGPASSWORD="$$(grep -E "^POSTGRES_PASSWORD=" /opt/lobechat/.env | head -1 | cut -d= -f2-)" -e RUSTFS_HOST=lobe-rustfs -e RUSTFS_BUCKET=lobe -e RUSTFS_SECRET_KEY="$$(grep -E "^RUSTFS_SECRET_KEY=" /opt/lobechat/.env | head -1 | cut -d= -f2-)" doc-editor:latest'
ExecStop=/usr/bin/docker stop doc-editor
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
